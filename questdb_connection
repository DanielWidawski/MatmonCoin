def create_trades_materilized_view(materilized_view_name: str, sample_by: str , TTL_time: str, refresh_rate: str, partition_by: str ) -> None:
   cur.execute(f""" CREATE MATERIALIZED VIEW {materilized_view_name} REFRESH EVERY {refresh_rate} AS (
                    SELECT symbol, timestamp, avg(price) AS avg_price, min(price) AS min_price, max(price) AS max_price
                    FROM trades
                    SAMPLE BY {sample_by}
               ) PARTITION BY {partition_by} {TTL_time}
                    """)
 
   
 
 
